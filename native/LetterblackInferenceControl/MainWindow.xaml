<Window x:Class="LetterblackInferenceControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LetterblackInferenceControl.Controls"
        Title="Letterblack Inference Control" Width="1180" Height="720" 
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="LETTERBLACK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Local Inference Workspace" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Control plane" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="ControlPlaneUrlTextBox" Width="250" Margin="0"/>
                    <Button Content="Connect / Refresh" Click="Refresh_Click" Background="{StaticResource Accent}" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                    <Button Content="Add Widget" Click="AddWidget_Click" Margin="8,0,0,0"/>
                    <Button Content="Save Layout" Click="SaveLayout_Click" Margin="0,0,8,0"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="Stop All" Click="StopAll_Click" Background="#3A171D" Foreground="#FECACA" BorderBrush="#66323A" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Panel -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="10,14">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceRaised}" CornerRadius="4" Padding="10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="CONTROL PLANE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="ControlPlaneStatusLabel" Text="Connecting..." FontSize="11" Foreground="{StaticResource Accent}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <RadioButton Content="Workspace" IsChecked="True" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="0"/>
                        <RadioButton Content="Models" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="1"/>
                        <RadioButton Content="Machines" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="2"/>
                        <RadioButton Content="Playground" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="3"/>
                        <RadioButton Content="Settings" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="{StaticResource Border}" ShowsPreview="True"/>

            <!-- Tab Control -->
            <TabControl x:Name="MainTabControl" Grid.Column="2" Background="Transparent" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Workspace Tab -->
                <TabItem>
                    <controls:WorkspaceContainer x:Name="WorkspaceContainer"/>
                </TabItem>

                <!-- Models Tab -->
                <TabItem>
                    <!-- Existing models grid -->
                </TabItem>

                <!-- Machines Tab -->
                <TabItem>
                    <!-- Existing machines grid -->
                </TabItem>

                <!-- Playground Tab -->
                <TabItem>
                    <!-- Existing playground -->
                </TabItem>

                <!-- Settings Tab -->
                <TabItem>
                    <!-- Existing settings -->
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,9">
            <TextBlock x:Name="StatusText" Text="Connect to the local control plane to load configuration." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>