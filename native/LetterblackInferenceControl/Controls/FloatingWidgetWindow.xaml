<Window x:Class="LetterblackInferenceControl.Controls.FloatingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" SizeToContent="WidthAndHeight"
        Topmost="False">
    <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="Widget" FontWeight="SemiBold" FontSize="12"/>
                    <Button Grid.Column="1" Content="✕" Click="Close_Click" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <ContentControl x:Name="WidgetContent" Margin="8"/>
        </DockPanel>
    </Border>
</Window>