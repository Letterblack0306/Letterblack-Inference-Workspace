<UserControl x:Class="LetterblackInferenceControl.Controls.Widgets.ActiveModelWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Active Model" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="StatusBadge" Grid.Column="1" Text="● Stopped" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,12,0"/>
                    <Button x:Name="CloseButton" Grid.Column="2" Content="✕" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
            <StackPanel Margin="16">
                <TextBlock x:Name="ModelName" Text="No model loaded" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button x:Name="SelectModelBtn" Content="Select model" Click="SelectModel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="StartBtn" Content="Start" Click="Start_Click" Background="{StaticResource Accent}" Foreground="#F8FAFC" Margin="0,0,8,0"/>
                    <Button x:Name="StopBtn" Content="Stop" Click="Stop_Click" Background="#3A171D" Foreground="#FECACA"/>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>